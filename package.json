{
  "name": "srtb-graphics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "prepare:ffmpeg-cbr": "node scripts/prepare-ffmpeg-cbr.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node tests/workflows.mjs",
    "test:mp4": "node tests/critical-path.mjs",
    "dev:studio": "vite --config vite.studio.config.ts",
    "build:studio": "node scripts/prepare-ffmpeg-cbr.mjs && node scripts/build-ba-editor.mjs && node scripts/build-preview-network.mjs && node scripts/prepare-preview-audio.mjs && node scripts/build-typography.mjs && tsc -p tsconfig.json && tsc -p tsconfig.server.json && vite build --config vite.studio.config.ts && node scripts/finish-studio-build.mjs && node scripts/build-studio-worker.mjs",
    "build:studio:native": "node scripts/build-studio-native.mjs",
    "build:studio:native:derivations": "node scripts/build-studio-native.mjs --derivations",
    "deploy:studio:native": "node scripts/check-studio-native-release.mjs",
    "deploy:studio:native:derivations": "node scripts/check-studio-native-release.mjs --derivations",
    "test:studio": "vitest run --config vitest.studio.config.ts",
    "deploy": "node scripts/check-studio-release.mjs",
    "cloudflare:create": "wrangler pages project create srtb-graphics --production-branch main",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test:portable": "node --import tsx --test tests/studio-asset-history.test.ts tests/session-state.test.ts tests/media-trim.test.ts tests/media-match-score.test.ts tests/local-fingerprint.test.ts tests/image-sizing.test.ts tests/form-exit-guard.test.ts tests/day-planner-import.test.ts",
    "dev:qa": "vite --config vite.qualification.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@aws-sdk/xml-builder": "3.972.40",
    "@lottiefiles/dotlottie-web": "0.80.0",
    "@mediabunny/prores": "1.58.1",
    "@noble/hashes": "2.4.0",
    "@smithy/fetch-http-handler": "5.8.0",
    "@soundtouchjs/core": "2.1.1",
    "fflate": "0.8.3",
    "firebase": "12.19.0",
    "jose": "6.2.12",
    "lucide-react": "0.577.0",
    "mediabunny": "1.58.1",
    "motion": "13.4.1",
    "pdfjs-dist": "6.3.289",
    "prores-wasm-encoder": "0.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "thinking-orbs": "0.3.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.2.0",
    "@cloudflare/workers-types": "5.20260921.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.135.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "description": "Browser-based broadcast graphics workspace | Studio web de production audiovisuelle"
}
